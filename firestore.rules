rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Sécurisation de la sous-collection "notes" pour chaque utilisateur
    match /users/{userId}/notes/{noteId} {
      
      // L'utilisateur doit être connecté ET correspondre à l'ID du document
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Par défaut, bloquer l'accès à tout le reste de la base de données
    match /{document=**} {
      allow read, write: if false;
    }
  }
}