rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Sécurisation de la sous-collection "notes" pour chaque utilisateur
    match /users/{userId}/notes/{noteId} {
      
      // L'utilisateur doit être connecté ET correspondre à l'ID du document
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Theme preferences belong exclusively to the authenticated account.
    match /users/{userId}/preferences/theme {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['theme', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['theme', 'updatedAt'])
        && request.resource.data.theme in ['light', 'dark']
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= 0;
    }

    // Deny access to every other document by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
